rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isValidImageUpload() {
      return request.resource != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }

    match /avatars/{uid}/{fileName} {
      allow read: if uid.matches('^[a-zA-Z0-9_\\-]+$');
      allow write: if uid.matches('^[a-zA-Z0-9_\\-]+$') && isValidImageUpload();
      allow delete: if uid.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /wishes/{uid}/{fileName} {
      allow read: if uid.matches('^[a-zA-Z0-9_\\-]+$');
      allow write: if uid.matches('^[a-zA-Z0-9_\\-]+$') && isValidImageUpload();
      allow delete: if uid.matches('^[a-zA-Z0-9_\\-]+$');
    }
  }
}
